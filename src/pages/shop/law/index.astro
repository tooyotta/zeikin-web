---
import Shop from "../../../layouts/Shop.astro";

// ダミー文言（2026-10-14、本人の指示で仮置き）。本番の販売を始める前に、本人が決めた内容に差し替える。
// 特に「販売業者」「所在地」「電話番号」の載せ方（請求時開示にするか、バーチャルオフィスにするか）と、送料・発送日数・返品条件。
const rows: [string, string][] = [
  ["販売業者", "税金ストア（運営者の氏名は、ご請求があった場合に遅滞なく開示します）"],
  ["運営責任者", "ご請求があった場合に遅滞なく開示します"],
  ["所在地", "ご請求があった場合に遅滞なく開示します"],
  ["電話番号", "ご請求があった場合に遅滞なく開示します"],
  ["メールアドレス", "info@zeikin.org"],
  ["販売価格", "各商品の「納税額」に表示（税込）"],
  ["商品代金以外の必要料金", "送料 全国一律 520円（決済画面で加算されます）"],
  ["支払方法", "クレジットカード（Square の決済ページ）"],
  ["支払時期", "ご注文時"],
  ["引渡時期", "ご注文から7日以内に発送します"],
  ["返品・交換", "商品に不良があった場合に限り、到着後7日以内に info@zeikin.org までご連絡ください。交換または返金で対応します"],
];
---

<Shop title="特定商取引法に基づく表記 — 税金ストア" description="特定商取引法に基づく表記">
  <section class="shop-head">
    <p class="shop-head__form">様式 ZK-S-L</p>
    <h1 class="shop-head__title shop-head__title--small">特定商取引法に基づく表記</h1>
  </section>
  <section class="law">
    <dl>
      {rows.map(([k, v]) => (
        <>
          <dt>{k}</dt>
          <dd class:list={{ "is-todo": v.includes("【要記入】") }}>{v}</dd>
        </>
      ))}
    </dl>
  </section>
</Shop>
