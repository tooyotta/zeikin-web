---
import "../styles/global.css";

const tickerText = ["Paying taxes™ is the chief end;", "Labor merely enables its"];

const links = {
  instagram: "https://www.instagram.com/zeikinorg/",
  tiktok: "https://www.tiktok.com/@zeikinorg",
  lineSticker: "https://store.line.me/emojishop/product/685a3cbc5891fa264f2d1bc4/ja",
  map: "https://maps.app.goo.gl/qzaq2KcP5BwNGdQ46",
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>zeikin.org — POP-UP Store</title>
    <meta name="description" content="zeikin POP-UP Store — 2025年6月29日 中野セントラルパーク" />
    <meta name="theme-color" content="#000000" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Fragment+Mono&family=Martian+Mono:wght@200&family=VT323&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <header class="ticker" aria-hidden="true">
        {
          [0, 1, 2].map(() => (
            <>
              <span class="ticker__sun">☼</span>
              <span class="ticker__content">
                {tickerText.map((t) => (
                  <span>{t}</span>
                ))}
              </span>
            </>
          ))
        }
      </header>

      <section class="intro">
        <video
          class="intro__video"
          autoplay
          muted
          loop
          playsinline
          poster="/media/key-graphic-poster.jpg"
          aria-hidden="true"
        >
          <source src="/media/key-graphic.webm" type="video/webm" />
          <source src="/media/key-graphic.mp4" type="video/mp4" />
        </video>
        <div class="intro__content">
          <p class="intro__headline">Tax time. Crunch. Munch. Numbers go brrrrrrrrrrrrrrrrrrr</p>
        </div>
      </section>

      <section class="landing">
        <div class="landing__headline-block">
          <h1 class="landing__headline">Event<br /><br />zeikin<br />POP-UP Store</h1>
        </div>
        <div class="landing__cta">
          <div class="landing__cta-headline">
            <p class="landing__cta-date">10AM-4PM<br />June 29, 2025<br />Nakano Central Park</p>
            <p class="landing__cta-sub">MOTTAINAI Flea market</p>
          </div>
          <div class="landing__cta-action">
            <a class="landing__map-link" href={links.map} target="_blank" rel="noopener">
              Google map
              <img src="/images/arrow.svg" alt="" />
            </a>
          </div>
        </div>
      </section>

      <section class="connect">
        <p class="connect__label">Product LINE UP ↓</p>
      </section>

      <section class="grid">
        <div class="grid__item grid__item--charcoal" style="--order: 0">
          <p class="grid__label">Clothes</p>
        </div>

        <div class="grid__item grid__item--pink" style="--order: 2">
          <img class="grid__tee" src="/images/tshirt-final.png" alt="T-shirt" />
          <div class="grid__caption">
            <span>T-Shirt</span>
            <span>Taxhund</span>
          </div>
        </div>

        <div class="grid__item" style="--order: 4">
          <div class="grid__crop grid__crop--gray">
            <img class="grid__cover" src="/images/photo10.png" alt="" />
          </div>
        </div>

        <div class="grid__item" style="--order: 6">
          <div class="grid__crop grid__crop--gray grid__crop--tee">
            <img src="/images/poet-tshirt.png" alt="" />
          </div>
        </div>

        <div class="grid__item grid__item--swap" style="--order: 8">
          <div class="grid__crop grid__crop--bag">
            <img src="/images/bag1.png" alt="Tote bag" />
          </div>
        </div>

        <div class="grid__item grid__item--charcoal" style="--order: 10">
          <p class="grid__label">Sticker</p>
        </div>

        <div class="grid__item grid__item--cyan" style="--order: 12">
          <img class="grid__ze" src="/images/sticker-5.png" alt="" />
          <div class="grid__caption">
            <span>Sticker Set</span>
            <span>TaxMoji</span>
          </div>
        </div>

        <div class="grid__item" style="--order: 14">
          <img class="grid__cover" src="/images/stickers-drawing.png" alt="" />
        </div>

        <div class="grid__item" style="--order: 16">
          <img class="grid__cover" src="/images/poet.png" alt="" />
        </div>

        <div class="grid__item grid__item--gray-dark" style="--order: 18">
          <img class="grid__vector" src="/images/vector-line.svg" alt="" />
        </div>

        <div class="grid__item grid__item--green" style="--order: 20">
          <p class="grid__label">LINE Emoji</p>
        </div>

        <div class="grid__item" style="--order: 22">
          <img class="grid__cover" src="/images/tax-cat.png" alt="" />
        </div>

        <div class="grid__item grid__item--link" style="--order: 24">
          <p class="grid__link-text">Online Shop<br />(Comming soon)</p>
        </div>

        <a
          class="grid__item grid__item--link grid__item--link-arrow"
          style="--order: 26"
          href={links.instagram}
          target="_blank"
          rel="noopener"
        >
          <p class="grid__link-text">Instagram</p>
          <img class="grid__arrow" src="/images/arrow-up-right.svg" alt="" />
        </a>

        <div class="grid__item" style="--order: 28">
          <img class="grid__cover" src="/images/hands-stickers.jpg" alt="" />
        </div>
      </section>

      <div class="ticker ticker--wide" aria-hidden="true">
        {
          [0, 1, 2].map(() => (
            <>
              <span class="ticker__sun">☼</span>
              <span class="ticker__content">
                {tickerText.map((t) => (
                  <span>{t}</span>
                ))}
              </span>
            </>
          ))
        }
      </div>

      <footer class="footer">
        <div class="footer__social">
          <h2 class="footer__heading">Contact us</h2>
          <ul class="footer__links">
            <li><a href={links.instagram} target="_blank" rel="noopener">Instagram</a></li>
            <li><a href={links.tiktok} target="_blank" rel="noopener">TikTok</a></li>
            <li><a href={links.lineSticker} target="_blank" rel="noopener">LINE Sticker</a></li>
          </ul>
        </div>
        <img class="footer__logo" src="/images/footer-logo.svg" alt="zeikin.org" />
      </footer>
    </div>
  </body>
</html>
