---
import "../styles/global.css";
import "../styles/ledger.css";
import Ticker from "../components/Ticker.astro";

interface Props {
  title: string;
  description: string;
  crumb?: string;
}
const { title, description, crumb } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Fragment+Mono&family=VT323&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
      // 画面遷移アニメが省略されたとき（非表示タブ等）の未処理エラーを黙らせる
      for (const ev of ["pageswap", "pagereveal"])
        addEventListener(ev, (e) => e.viewTransition && e.viewTransition.ready.catch(() => {}));
    </script>
  </head>
  <body class="lg-body">
    <Ticker as="div" />
    <header class="lg-bar">
      <a class="lg-bar__home" href="/ledger/">税金台帳<span>ZK-L</span></a>
      {crumb && <span class="lg-bar__crumb">{crumb}</span>}
      <nav class="lg-bar__nav">
        <a href="/ledger/#records">申告</a>
        <a href="/ledger/#lineage">系譜</a>
        <a href="/">zeikin.org</a>
      </nav>
    </header>
    <main class="lg">
      <slot />
    </main>
    <footer class="lg-foot">
      <p class="lg-foot__mark">すべての活動は、申告として台帳に積まれる。</p>
      <p class="lg-foot__meta">
        <a href="/ledger/">税金台帳</a>
        <a href="/">zeikin.org</a>
        <span>様式 ZK-L</span>
      </p>
    </footer>
  </body>
</html>
